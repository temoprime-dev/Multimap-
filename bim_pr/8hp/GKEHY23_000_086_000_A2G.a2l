    /begin MEASUREMENT ECE_CC08_stSpiDiag "F2366: SPI diagnosis info: B15:ident correct,B14:DN,B13:CLKERR,B12:SEL,B10:SPI-Data-Err,B9:SPI-Err,B8:SPI-ok;B7:NOC,B6:RCHG,B5:OT,B4:OC,B3:OC,B2:NS,B1+0:ERR"
