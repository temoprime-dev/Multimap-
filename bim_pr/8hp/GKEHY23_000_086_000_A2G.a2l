      ECU_ADDRESS 0xFFF94143
      ECU_ADDRESS_EXTENSION 0x0
      FORMAT "%5.1"
    /end MEASUREMENT

    /begin MEASUREMENT ECC_ROM_stEccTst "F2755: last memorized ECC-Test status B0-3: (2 = Test was not executed, 1 = Test was passed,0=Test was executed and failed) B4-7: alive counter "
