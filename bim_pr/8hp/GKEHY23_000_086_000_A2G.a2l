      ECU_ADDRESS_EXTENSION 0x0
      EXTENDED_LIMITS 0.01 0.4
      FORMAT "%9.7"
    /end CHARACTERISTIC

    /begin CHARACTERISTIC MCorAdc_uVdd3Max_C "F6020: Upper threshold voltage whereas an error will report to SAF when Vdd3 exceeds this voltage (no SERAP)"
