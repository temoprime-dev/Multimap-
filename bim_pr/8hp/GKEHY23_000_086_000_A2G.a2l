      FORMAT "%8.5"
      MATRIX_DIM 3 1 1
    /end MEASUREMENT

    /begin CHARACTERISTIC ECE_CC08_tiDithIsrFast_C "F2366: CG208 dither interrupt timing parameters (idx0:dly sample-high, idx1:dly sample-low, idx2:dly period)  (table used if ECE_CC08_regDfr_C Bit5 is set (0.32ms)) (no SERAP)"
