    /begin MEASUREMENT MCorAdc_ctErr "F6020: Error counter"
      UBYTE X1_S1 1 100 0 255
      ECU_ADDRESS 0xFFF94917
      ECU_ADDRESS_EXTENSION 0x0
      FORMAT "%5.1"
    /end MEASUREMENT

    /begin CHARACTERISTIC MCorAdc_ctErrDb_C "F6020: Error debounce time (multiples of SAF task invokations) (no SERAP)"
      VALUE 0x19191A AblGLKWub_S1 2 X1_S1 1 3
      ECU_ADDRESS_EXTENSION 0x0
      EXTENDED_LIMITS 1 3
      FORMAT "%5.3"
    /end CHARACTERISTIC

    /begin MEASUREMENT MCorAdc_efADCTst "F6020: Indicate a current error is present"
      UBYTE B_TRUE_S1 1 100 0 1
      ECU_ADDRESS 0xFFF939E4
      ECU_ADDRESS_EXTENSION 0x0
      FORMAT "%13.11"
    /end MEASUREMENT

    /begin MEASUREMENT MCorAdc_stAdcFault "F6020: status MCor ADC test (Bit0=Vasic out of range, Bit1=VDD3 difference out of range, Bit2=VDD3 out of range, Bit3=diagnostic channel out of range)"
      UBYTE X1_S1 1 100 0 255
      ECU_ADDRESS 0xFFF93B31
      ECU_ADDRESS_EXTENSION 0x0
      FORMAT "%5.1"
    /end MEASUREMENT

    /begin CHARACTERISTIC MCorAdc_uDiagDiffMax_C "F6020: Max. voltage difference of the Diag. ch. whereas no error will report to SAF (no SERAP)"
      VALUE 0x19158E AblGLKWuw_S1 60 X1_S1 0 60
      ECU_ADDRESS_EXTENSION 0x0
      EXTENDED_LIMITS 0 60
      FORMAT "%8.5"
    /end CHARACTERISTIC

    /begin CHARACTERISTIC MCorAdc_uM3Min_C "F6020: Threshold voltage of M3 under which MCor diagnostic is disabled for old cg124 (no SERAP)"
      VALUE 0x191590 AblGLKWuw_S1 0.9 U0_001_S1 5.6 6.5
      ECU_ADDRESS_EXTENSION 0x0
      EXTENDED_LIMITS 5.6 6.5
      FORMAT "%8.6"
    /end CHARACTERISTIC

    /begin CHARACTERISTIC MCorAdc_uVasicMax_C "F6020: Upper threshold voltage whereas an error will report to SAF when Vasic exceeds this voltage (no SERAP)"
      VALUE 0x191592 AblGLKWuw_S1 0.7 U0_001_S1 5.3 6
      ECU_ADDRESS_EXTENSION 0x0
      EXTENDED_LIMITS 5.3 6
      FORMAT "%8.6"
    /end CHARACTERISTIC

    /begin CHARACTERISTIC MCorAdc_uVasicMin_C "F6020: Lower threshold voltage whereas an error will report to SAF when Vasic remain under this voltage (no SERAP)"
      VALUE 0x191594 AblGLKWuw_S1 0.2 U0_001_S1 4.5 4.7
      ECU_ADDRESS_EXTENSION 0x0
      EXTENDED_LIMITS 4.5 4.7
      FORMAT "%8.6"
    /end CHARACTERISTIC

    /begin CHARACTERISTIC MCorAdc_uVdd3DiffMax_C "F6020: Max. Difference voltage whereas an error will report to SAF when difference voltage between VDD3 and VDD3 alternative exceeds this value (no SERAP)"
