      ECU_ADDRESS 0xFFF93F68
      ECU_ADDRESS_EXTENSION 0x0
      FORMAT "%13.2"
    /end MEASUREMENT

    /begin MEASUREMENT ECC_RAM_numEccErr "F2755: number of registered bit ECC-error corrections per observation period - if this number exceeds threshold a resed occurs"
      ULONG X1_S1 1 100 0 4294967295
