    /begin FUNCTION SAS "Das Paket SAS enthält alle Klassen und Funktionalitäten, welche zur Koordination des Schaltablaufs notwendig sind."
      /begin SUB_FUNCTION
        GEA 
        SAS_REGELUNG 
        SAS_ZENTRAL 
        SAS_SYSTEMDRUCK 
        TCI 
        SAS_KOORDINATOR 
        SAS_SONDERFKT 
        SAS_MOTOREINGRIFF 
      /end SUB_FUNCTION 
    /end FUNCTION

    /begin FUNCTION SAS_KOORDINATOR "In SAS_KOORDINATOR sind die Koordinationsfunktionen des Schaltablaufs enthalten"
      /begin IN_MEASUREMENT
        iKorSaste.kup_ge1 iKorSaste.kup_ge2 iKorSaste.kup_ge3 iKorSaste.kup_kab iKorSaste.kup_kabvkzu iKorSaste.kup_kzu iKorSaste.kup_vkab iKorSaste.kup_vkzu 
        iKorSaste.m_t_mepos iKorSaste.me_sas_status iKorSaste.n_motmax iKorSaste.n_tmax iKorSaste.schaltungsabbruch_durch_ga iKorSaste.timer_ende_ga iKorSaste.zielgang_vorb_angefordert iKorSaste.zielgang_vorbereitung 
      /end IN_MEASUREMENT
    /end FUNCTION

    /begin FUNCTION SAS_MOTOREINGRIFF "In SAS_MOTOREINGRIFF sind die Klassen zur Steuerung des Motoreingriffs während Schaltablauf enthalten"
      /begin IN_MEASUREMENT
        iMoeMesaf.f_neuber_startz_hme_hs_angef iMoeMesaf.f_neuber_startz_hme_hs_erfolgt iMoeMesaf.f_unterdr_me iMoeMesaf.filter_spez_me.letzter_ms_timer iMoeMesaf.filter_spez_me.start_wert iMoeMesaf.filter_spez_me.x iMoeMesaf.flag_me_haupt_aktiv iMoeMesaf.flag_schaltung_mes_aktiv 
        iMoeMesaf.me_sas iMoeMesaf.me_sas0_mee iMoeMesaf.me_sas_gesp iMoeMesaf.me_sas_gesp_kf iMoeMesaf.me_sas_int iMoeMesaf.me_sas_pos_vor iMoeMesaf.me_sas_pos_vor_stat iMoeMesaf.me_sas_start_nach_me 
        iMoeMesaf.me_sas_zwme_max iMoeMesaf.momentenerhoehung_erlaubt iMoeMesaf.momentenerhoehung_erlaubt_alt iMoeMesaf.nachme_rs_losgelaufen iMoeMesaf.ng_abmesas iMoeMesaf.offset_n_motsolleer iMoeMesaf.schalttyp_mes iMoeMesaf.t_ramee 
        iMoeMesaf.t_zmes iMoeMesaf.timer_maxzeit_mes iMoeMesaf.timer_ramee iMoeMesaf.timer_rampe_pos iMoeMesaf.timer_schaltung_mes iMoeMesaf.timer_zmes iMoeMesaf.verbot_sas_fkt_alt iMoeMesaf.z_mes 
        iMoeMesaf.zaehler_zmes iMoeMesaf.zust_haupt_me_gestartet 
      /end IN_MEASUREMENT
    /end FUNCTION

    /begin FUNCTION SAS_REGELUNG "In SAS_REGELUNG sind Methoden für die Regelung (z.B. GLS)"
      /begin IN_MEASUREMENT
        iSasAnGls.filter_wngtgls.letzter_ms_timer iSasAnGls.filter_wngtgls.x iSasAnGls.filter_wngtgls_gestartet iSasAnGls.gls_aktiv iSasAnGls.gls_mindruck iSasAnGls.gls_para.cBibRegle._.faktor_d iSasAnGls.gls_para.cBibRegle._.faktor_i iSasAnGls.gls_para.cBibRegle._.faktor_p 
        iSasAnGls.gls_para.cBibRegle._.faktor_t1 iSasAnGls.gls_para.cBibRegle._.regel_diff_alt iSasAnGls.gls_para.cBibRegle._.stell_max iSasAnGls.gls_para.cBibRegle._.stell_min iSasAnGls.gls_para.cBibRegle._.stellgr_alt iSasAnGls.gls_para.cBibRegle._.stellgr_d_alt iSasAnGls.gls_para.cBibRegle._.stellgr_i_alt iSasAnGls.gls_para.cBibRegle._.stellgr_i_modulo 
        iSasAnGls.n_tmaxge iSasAnGls.ng_tgls iSasAnGls.p_gls iSasAnGls.p_gls_kab iSasAnGls.p_gls_kzu iSasAnGls.p_i_gls iSasAnGls.p_maxgls iSasAnGls.p_mingls 
        iSasAnGls.reg_gls_gestartet iSasAnGls.schalttyp_gls iSasAnGls.schaltung_gls iSasAnGls.t_sgls iSasAnGls.t_zgls iSasAnGls.timer_sgls iSasAnGls.timer_vglskab iSasAnGls.timer_vglskzu 
        iSasAnGls.timer_zgls iSasAnGls.verz_gls_gestartet iSasAnGls.w_ngtgls iSasAnGls.w_ngtnomgls iSasAnGls.w_tsgls iSasAnGls.wechsel_normal_kurz iSasAnGls.z_gls iSasAnGls.z_gls_regler 
        iSasAnGls.zaehler_zgls iSasAnGls.zug_schub_gls 
      /end IN_MEASUREMENT
    /end FUNCTION

