      ECU_ADDRESS_EXTENSION 0x0
      FORMAT "%5.1"
    /end MEASUREMENT

    /begin MEASUREMENT Rom_RomChsCycTst_stChsInfo "F1350: Bit coded. Bit0: Chs calc is ready, Bit1: Chs calc is not ready"
