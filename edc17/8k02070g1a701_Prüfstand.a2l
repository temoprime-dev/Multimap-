    "Bedingung LBK hoher Strom schliessend bei Motor aus -> Neulernen"
    UBYTE
    B_TRUE
    1
    100
    0
    1

    BIT_MASK 0x10
    FORMAT "%13.11"
    
    ECU_ADDRESS 0x8010B7
    /begin IF_DATA ASAP1B_CCP KP_BLOB 0x00 0x8010B7 1 /end IF_DATA
    /begin IF_DATA ASAP1B_ADDRESS  KP_BLOB 0x8010B7 /end IF_DATA
    /begin IF_DATA ETK  KP_BLOB 0x8010B7 INTERN 0x1 /end IF_DATA
    /begin IF_DATA ASAP1B_KWP2000  KP_BLOB  0x8010B7  INTERN  0x1  /end IF_DATA 

/end MEASUREMENT

