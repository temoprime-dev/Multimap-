    "Bedingung: es liegt kein Fehler im Fehlerpfad LSV vor"
    UBYTE
    B_TRUE
    1
    100
    0
    1

    BIT_MASK 0x2
    FORMAT "%13.11"
    
    ECU_ADDRESS 0x8008CF
    /begin IF_DATA ASAP1B_CCP KP_BLOB 0x00 0x8008CF 1 /end IF_DATA
    /begin IF_DATA ASAP1B_ADDRESS  KP_BLOB 0x8008CF /end IF_DATA
    /begin IF_DATA ETK  KP_BLOB 0x8008CF INTERN 0x1 /end IF_DATA
