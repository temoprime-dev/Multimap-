		  1
		  /begin QP_BLOB
		      1
			  LENGTH 5
			  CAN_ID_FIXED 0x6AA
			  RASTER 1
		  /end QP_BLOB
	  /end SOURCE
  
      /begin SOURCE
	      "segment synchronous event channel"
		  103
		  1
		  /begin QP_BLOB
		      2
			  LENGTH 1
			  CAN_ID_FIXED 0x6A8
			  RASTER 2
		  /end QP_BLOB
	  /end SOURCE
  
      /begin RASTER
	      "time synchronous event channel - 10 ms"
	      "10_ms"
		  0
		  4
		  1
	  /end RASTER
  
      /begin RASTER
	      "time synchronous event channel - 100 ms"
	      "100_ms"
		  1
		  5
		  1
	  /end RASTER
  
      /begin RASTER
	      "segment synchronous event channel"
	      "seg_sync"
		  2
		  103
		  1
	  /end RASTER
  
	  /begin SEED_KEY
	      /* seed&key dll for CAL privilege */ ""
	      /* seed&key dll for DAQ privilege */ ""
	      /* seed&key dll for PGM privilege */ ""
	  /end SEED_KEY
  
	  /begin TP_BLOB
	      /* CCP version       */ 0x201
		  /* Blob version      */ 0x202
		  /* CAN msg ID - send */ 0x630
		  /* CAN msg ID - recv */ 0x631
		  /* station address   */ 0x1
		  /* byte order        */ 1
          
		  /begin CAN_PARAM
		      /* crystal frequency */ 0x1F4
			  /* timing register 0 */ 0x41
			  /* timing register 1 */ 0x25
		  /end CAN_PARAM
          
		  DAQ_MODE    BURST
		  CONSISTENCY ODT
		  ADDRESS_EXTENSION ODT
		  
	      /begin CHECKSUM_PARAM 
		  	  /* algorithm */ 0x8006
		      /* limit     */ 0xFFFFFFFF
		      CHECKSUM_CALCULATION ACTIVE_PAGE
		  /end CHECKSUM_PARAM 
          
		  /begin DEFINED_PAGES
		      1
			  "reference page"
			  /* address ext. */ 0x1
			  /* base address */ 0x5C2000
			  /* page length  */ 0x1DFFF
			  ROM
		  /end DEFINED_PAGES
          
		  /begin DEFINED_PAGES
		      2
			  "working page"
			  /* address ext. */ 0x0
			  /* base address */ 0x902000
			  /* page length  */ 0x1DFFF
			  RAM
			  RAM_INIT_BY_TOOL
		  /end DEFINED_PAGES
          
		  OPTIONAL_CMD 0xC  /* SELECT_CAL_PAGE */
		  OPTIONAL_CMD 0xD  /* BUILD_CHKSUM */
		  OPTIONAL_CMD 0xE  /* MOVE */
		  OPTIONAL_CMD 0x11  /* GET_ACTIVE_CAL_PAGE */
		  OPTIONAL_CMD 0x19  /* SET_S_STATUS */
		  OPTIONAL_CMD 0xD  /* GET_S_STATUS */
		  OPTIONAL_CMD 0x12  /* GET_SEED */
		  OPTIONAL_CMD 0x13  /* UNLOCK */
	  /end TP_BLOB
  /end IF_DATA

