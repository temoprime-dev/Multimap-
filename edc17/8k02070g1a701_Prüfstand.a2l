    "Zyklusflag: DV-E-Fehler bei Federpr¸fung ""÷ffnen"""
    UWORD
    B_TRUE
    1
    100
    0
    1

    BIT_MASK 0x2
    FORMAT "%13.11"
    
    ECU_ADDRESS 0x7FC8D8
    /begin IF_DATA ASAP1B_CCP KP_BLOB 0x00 0x7FC8D8 2 /end IF_DATA
    /begin IF_DATA ASAP1B_ADDRESS  KP_BLOB 0x7FC8D8 /end IF_DATA
    /begin IF_DATA ETK  KP_BLOB 0x7FC8D8 INTERN 0x2 /end IF_DATA
    /begin IF_DATA ASAP1B_KWP2000  KP_BLOB  0x7FC8D8  INTERN  0x2  /end IF_DATA 

/end MEASUREMENT

