    "Bedingung Fehler Drucksensor maximale Spannung"
    UBYTE
    B_TRUE
    1
    100
    0
    1

    BIT_MASK 0x8
    FORMAT "%13.11"
    
    ECU_ADDRESS 0x80109F
    /begin IF_DATA ASAP1B_CCP KP_BLOB 0x00 0x80109F 1 /end IF_DATA
    /begin IF_DATA ASAP1B_ADDRESS  KP_BLOB 0x80109F /end IF_DATA
    /begin IF_DATA ETK  KP_BLOB 0x80109F INTERN 0x1 /end IF_DATA
