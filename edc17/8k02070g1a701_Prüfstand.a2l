    "Plausibilit‰ts-Fehler: Vertauschte Lambda-Sonden"
    UWORD
    B_TRUE
    1
    100
    0
    1

    BIT_MASK 0x800
    FORMAT "%13.11"
    
    ECU_ADDRESS 0x7FC980
    /begin IF_DATA ASAP1B_CCP KP_BLOB 0x00 0x7FC980 2 /end IF_DATA
    /begin IF_DATA ASAP1B_ADDRESS  KP_BLOB 0x7FC980 /end IF_DATA
    /begin IF_DATA ETK  KP_BLOB 0x7FC980 INTERN 0x2 /end IF_DATA
    /begin IF_DATA ASAP1B_KWP2000  KP_BLOB  0x7FC980  INTERN  0x2  /end IF_DATA 

/end MEASUREMENT

