    /begin MEASUREMENT ZFFSAB._.TurbineSpeedVirtualIn.n_TuVirtOptSts "0 = alle anderen Faelle [k-Faktoren] 1 = waehrend Schaltung und IAE geschlossen [n_em] 2 = waehrend Schaltung und IAE im Schlupf [k-Faktoren] 3 = ausserhalb Schaltungen und Kraftschluss und kleiner 6. Gang [n_ab * i_Gang] 4 = ausserhalb Schaltungen und..."
      UBYTE SAB_STANDARD_S2_S3 1 100 0 255
      /begin ANNOTATION
        ANNOTATION_LABEL "Description"
        /begin ANNOTATION_TEXT
          "0 = alle anderen Faelle [k-Faktoren] 1 = waehrend Schaltung und IAE geschlossen [n_em] 2 = waehrend Schaltung und IAE im Schlupf [k-Faktoren] 3 = ausserhalb Schaltungen und Kraftschluss und kleiner 6. Gang [n_ab * i_Gang] 4 = ausserhalb Schaltungen und Kr" "aftschluss und groesser 6. Gang [n_ab * i_Gang] 5 = ausserhalb Schaltungen und ohne Kraftschluss [k-Faktoren]" 
        /end ANNOTATION_TEXT
      /end ANNOTATION
