      /begin ANNOTATION
        ANNOTATION_LABEL "Description"
        /begin ANNOTATION_TEXT
          "Bit coded error flags indicating an error in IEP or communicating to IEP: 0=no error :: errors bit31..bit24=ErrorByte1 bit23..bit16=ErrorByte0 bit13=SWNrErr bit12=HWNrErr bit9=CRC8Err bit8=BusOff bit7=NotReceived bit6..5=- bit4=AliveCnt bit3=LIN Chksum bi" "t2=- bit1=LINBus bit0=timeout" 
